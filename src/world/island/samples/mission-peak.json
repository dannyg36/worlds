    "code": "const g = k.group(), T = k.THREE; const grass = k.mat('#a3a457'), dry = k.mat('#bfae63'), rock = k.mat('#8d8578'), oak = k.mat('#4f6b35'), dirt = k.mat('#cdb08a'); const P = [[2.4, 0], [2.2, 0.3], [1.75, 1.0], [1.2, 2.0], [0.75, 2.9], [0.4, 3.55], [0.12, 3.9], [0, 3.95]]; k.put(g, k.lathe([[0, 0], ...P], grass, 9), 0, 0, 0, 0, 0.3, 0); k.put(g, k.lathe([[0, 0], [1.6, 0], [1.35, 0.5], [0.85, 1.25], [0.35, 1.8], [0, 1.9]], dry, 8), 1.45, 0, -0.5, 0, 0.5, 0); k.put(g, k.lathe([[0, 0], [1.1, 0], [0.85, 0.4], [0.4, 0.9], [0, 1.0]], dry, 7), -1.6, 0, -0.6); const rAt = (h) => { for (let i = 1; i < P.length; i++) if (h <= P[i][1]) { const t = (h - P[i - 1][1]) / (P[i][1] - P[i - 1][1]); return P[i - 1][0] + t * (P[i][0] - P[i - 1][0]); } return 0; }; const trail = []; for (let i = 0; i <= 20; i++) { const t = i / 20, h = 0.05 + t * 3.6, a = 0.2 + t * Math.PI * 2.2, r = rAt(h) + 0.02; trail.push([Math.sin(a) * r, h, Math.cos(a) * r]); } k.put(g, k.tube(trail, 0.05, dirt, 48), 0, 0, 0); const crown = [[0, 3.85, 0, 0.28], [0.22, 3.68, 0.12, 0.2], [-0.22, 3.64, 0.1, 0.22], [0.1, 3.55, -0.26, 0.24], [-0.2, 3.4, -0.22, 0.2], [0.32, 3.3, -0.1, 0.18]]; for (const [x, y, z, s] of crown) k.put(g, new T.Mesh(new T.IcosahedronGeometry(s, 1), rock), x, y, z, k.rand(), k.rand(), 0); for (let i = 0; i < 12; i++) { const h = 0.4 + k.rand() * 2.8, a = k.rand() * Math.PI * 2, r = rAt(h) - 0.05; k.put(g, new T.Mesh(new T.IcosahedronGeometry(0.12 + k.rand() * 0.14, 0), rock), Math.sin(a) * r, h, Math.cos(a) * r, k.rand(), k.rand(), 0); } for (let i = 0; i < 10; i++) { const h = 0.15 + k.rand() * 1.2, a = k.rand() * Math.PI * 2, r = rAt(h) - 0.05; const o = new T.Mesh(new T.IcosahedronGeometry(0.22 + k.rand() * 0.12, i % 2), oak); o.scale.set(1, 0.8, 1); k.put(g, o, Math.sin(a) * r, h + 0.1, Math.cos(a) * r); } return g;"
