          "code": "const g = k.group();\nconst W = 2.1, y0 = 0.72, frame = k.mat('#f4efe6');\nconst bands = [['#ffd36e', 0, 0.28], ['#ff9a4a', 0.28, 0.34], ['#f2667a', 0.62, 0.34], ['#8a5fa8', 0.96, 0.32]];\nfor (const [c, b, h] of bands) k.put(g, k.box(W, h, 0.02, k.glowMat(c, 1.15)), 0, y0 + b + h / 2, 0);\nk.put(g, k.cyl(0.26, 0.26, 0.02, k.glowMat('#fff2c0', 2.6)), 0.5, y0 + 0.3, 0.012, Math.PI / 2, 0, 0);\nconst city = k.mat('#4a2f55');\nlet x = -W / 2 + 0.08;\nwhile (x < W / 2 - 0.08) {\n  const w = 0.1 + k.rand() * 0.14, h = 0.08 + k.rand() * 0.32;\n  k.put(g, k.box(w, h, 0.02, city), x + w / 2, y0 + h / 2, 0.022);\n  x += w + 0.01;\n}\nfor (const s of [-1, 1]) {\n  k.put(g, k.rbox(0.09, 1.42, 0.1, frame, 0.02), (W / 2 + 0.03) * s, y0 + 0.65, 0.03);\n  k.put(g, k.rbox(0.05, 1.3, 0.06, frame, 0.015), (W / 6) * s, y0 + 0.65, 0.04);\n}\nk.put(g, k.rbox(W + 0.16, 0.09, 0.1, frame, 0.02), 0, y0 + 1.33, 0.03);\nk.put(g, k.rbox(W + 0.24, 0.07, 0.2, frame, 0.02), 0, y0 - 0.03, 0.08);\nk.put(g, k.rbox(W, 0.04, 0.06, frame, 0.015), 0, y0 + 0.7, 0.04);\nk.addLight([0, 1.5, 0.8], '#ff9a5a', 2.2, 5);\nreturn g;"
