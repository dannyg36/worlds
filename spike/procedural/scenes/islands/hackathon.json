          "code": "const g = k.group(), T = k.THREE;\nconst frame = k.mat('#b8bcc4', { metal: 0.5, rough: 0.4 }), white = k.mat('#fbfbf7', { rough: 0.3 });\nfor (const x of [-0.82, 0.82]) {\n  k.put(g, k.cyl(0.022, 0.022, 1.75, frame), x, 0.95, 0);\n  k.put(g, k.box(0.06, 0.05, 0.55, frame), x, 0.06, 0);\n}\nk.put(g, k.rbox(1.66, 1.04, 0.045, frame, 0.015), 0, 1.32, 0);\nk.put(g, k.box(1.56, 0.94, 0.01, white), 0, 1.32, 0.024);\nk.put(g, k.box(1.3, 0.03, 0.09, frame), 0, 0.79, 0.06);\nconst ink = (c) => k.mat(c, { rough: 0.6 });\nconst db = (x, c) => {\n  const m = ink(c);\n  for (const y of [1.6, 1.48, 1.36]) {\n    const t = new T.Mesh(new T.TorusGeometry(0.12, 0.009, 4, 20), m);\n    t.scale.y = 0.32;\n    k.put(g, t, x, y, 0.032);\n  }\n  for (const s of [-1, 1]) k.put(g, k.box(0.016, 0.24, 0.006, m), x + 0.12 * s, 1.48, 0.032);\n  for (const dy of [0, 0.1, 0.2]) k.put(g, k.box(0.3 - dy, 0.014, 0.006, m), x - dy / 2, 1.0 + dy, 0.032);\n};\ndb(-0.45, '#2a62c9');\ndb(0.45, '#d4213d');\nk.put(g, k.tube([[-0.2, 1.62, 0.032], [-0.06, 1.42, 0.032], [0.06, 1.52, 0.032], [0.2, 1.3, 0.032]], 0.011, ink('#222')), 0, 0, 0);\nk.put(g, k.box(0.36, 0.014, 0.006, ink('#222')), 0, 1.15, 0.032, 0, 0, 0.5);\nk.put(g, k.box(0.36, 0.014, 0.006, ink('#222')), 0, 1.15, 0.032, 0, 0, -0.5);\nconst notes = [[-0.66, 1.68, '#f7e463'], [0.66, 1.67, '#f59ab5'], [0.68, 0.98, '#9fe3c4'], [-0.68, 0.98, '#f7e463'], [-0.55, 1.7, '#f59ab5']];\nfor (const [x, y, c] of notes) k.put(g, k.box(0.11, 0.11, 0.008, k.mat(c)), x, y, 0.034, 0, 0, (k.rand() - 0.5) * 0.4);\nfor (const [x, c] of [[-0.25, '#2a62c9'], [-0.08, '#d4213d'], [0.1, '#222']]) k.put(g, k.cyl(0.013, 0.013, 0.13, k.mat(c)), x, 0.82, 0.07, 0, 0, Math.PI / 2);\nreturn g;"
